FROM docker.m.daocloud.io/library/node:24-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm config set registry https://registry.npmmirror.com/ && npm config set replace-registry-host always && npm ci --no-audit --no-fund
COPY next.config.ts postcss.config.mjs tsconfig.json ./
COPY src ./src
COPY public ./public
ENV BACKEND_URL=http://api:8000
RUN npm run build

FROM docker.m.daocloud.io/library/node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
