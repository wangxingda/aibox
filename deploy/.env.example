MYSQL_PASSWORD=replace-with-url-safe-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TOKEN=
CORS_ORIGINS=https://aibox.idiandian.xyz
COOKIE_SECURE=true
# 管理员用户 ID，多个以逗号分隔
ADMIN_USER_IDS=

# 证书目录默认是项目同级 shared/tls，须包含 fullchain.pem 和 privkey.pem。
# AIBOX_TLS_DIR=/absolute/path/to/tls

# HITS 正式环境须设置双方一致的独立随机密钥。
# HITS_BASE_URL=https://idiandian.xyz
# HITS_CLIENT_ID=aibox
# HITS_CLIENT_SECRET=
# HITS_CALLBACK_URL=https://aibox.idiandian.xyz/api/auth/hits/callback
